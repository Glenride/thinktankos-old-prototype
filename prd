## 3. Database Schema Blueprint

```sql
-- Core Tenants
CREATE TABLE tenants (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL UNIQUE,
    custom_domain VARCHAR(255) UNIQUE,
    settings JSONB NOT NULL DEFAULT '{}'::jsonb,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Global User Authentication
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    remember_token VARCHAR(100),
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Organization Memberships (RBAC)
CREATE TABLE tenant_users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    role VARCHAR(50) NOT NULL,
    permissions JSONB NOT NULL DEFAULT '[]'::jsonb,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT uq_tenant_user UNIQUE (tenant_id, user_id)
);

-- Talent Profiles
CREATE TABLE scholars (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    user_id UUID REFERENCES users(id) ON DELETE SET NULL,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    slug VARCHAR(150) NOT NULL,
    title VARCHAR(150) NOT NULL,
    bio TEXT,
    expertise_tags TEXT[] DEFAULT '{}',
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT uq_scholar_slug_per_tenant UNIQUE (tenant_id, slug),
    CONSTRAINT uq_scholar_composite UNIQUE (id, tenant_id)
);

-- Publishing: Core Policy Briefs
CREATE TABLE publications (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    title VARCHAR(500) NOT NULL,
    slug VARCHAR(500) NOT NULL,
    summary TEXT,
    status VARCHAR(50) NOT NULL DEFAULT 'draft',
    embargo_until TIMESTAMPTZ,
    published_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT uq_publication_slug_per_tenant UNIQUE (tenant_id, slug),
    CONSTRAINT uq_publication_composite UNIQUE (id, tenant_id)
);

-- Publishing: Revisions & Editorial Versions
CREATE TABLE publication_versions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL,
    publication_id UUID NOT NULL,
    version_number INT NOT NULL,
    content JSONB NOT NULL,
    changelog TEXT,
    created_by_user_id UUID REFERENCES users(id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    FOREIGN KEY (publication_id, tenant_id) 
        REFERENCES publications(id, tenant_id) ON DELETE CASCADE,
    CONSTRAINT uq_version_per_publication UNIQUE (publication_id, version_number)
);

-- Publishing: Authorship Junction
CREATE TABLE publication_authors (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL,
    publication_id UUID NOT NULL,
    scholar_id UUID,
    external_author_name VARCHAR(255),
    display_order INT NOT NULL DEFAULT 1,
    is_lead_author BOOLEAN NOT NULL DEFAULT FALSE,
    FOREIGN KEY (publication_id, tenant_id) 
        REFERENCES publications(id, tenant_id) ON DELETE CASCADE,
    FOREIGN KEY (scholar_id, tenant_id) 
        REFERENCES scholars(id, tenant_id) ON DELETE SET NULL
);

-- Events: Roundtables & Salons
CREATE TABLE events (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    title VARCHAR(300) NOT NULL,
    slug VARCHAR(300) NOT NULL,
    description TEXT,
    chatham_house_rule BOOLEAN NOT NULL DEFAULT FALSE,
    visibility VARCHAR(50) NOT NULL DEFAULT 'private',
    starts_at TIMESTAMPTZ NOT NULL,
    ends_at TIMESTAMPTZ NOT NULL,
    capacity INT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT uq_event_slug_per_tenant UNIQUE (tenant_id, slug),
    CONSTRAINT uq_event_composite UNIQUE (id, tenant_id)
);

-- Events: VIP Attendee Registrations
CREATE TABLE event_registrations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL,
    event_id UUID NOT NULL,
    full_name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    organization VARCHAR(255),
    title VARCHAR(255),
    status VARCHAR(50) NOT NULL DEFAULT 'pending',
    checked_in_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    FOREIGN KEY (event_id, tenant_id) 
        REFERENCES events(id, tenant_id) ON DELETE CASCADE,
    CONSTRAINT uq_event_registration UNIQUE (event_id, email)
);
```

